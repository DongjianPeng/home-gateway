# compose 变量（复制为 .env，已被 .gitignore 排除）；./ctl.sh init 会自动复制

# 域名后缀：w350t 本机服务用 <服务>.w350t.sz，云服务器（腾讯云 continuum）上经隧道拉过来的用 <服务>.tx.w350t.sz
DOMAIN_SUFFIX=w350t.sz

# 隧道用的私钥与 known_hosts：直接用 w350t root 登 continuum 的那把，只读挂进隧道容器
TUNNEL_KEY=/root/.ssh/id_rsa
TUNNEL_KNOWN_HOSTS=/root/.ssh/known_hosts
# w350t 上 ~/.ssh/config 里云服务器的别名，./ctl.sh init 用 ssh -G 取它的地址 / 用户 / 端口生成 ssh/hosts.conf
TUNNEL_SSH_ALIAS=continuum

TRAEFIK_IMAGE=docker.io/traefik:v3.5
