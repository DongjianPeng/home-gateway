# compose 变量（复制为 .env，已被 .gitignore 排除）；./ctl.sh init 会自动复制

# 域名后缀：w350t 本机服务用 <服务>.w350t.sz，云服务器（腾讯云 continuum）上经隧道拉过来的用 <服务>.tx.w350t.sz
DOMAIN_SUFFIX=w350t.sz

# 隧道用的私钥与 known_hosts：直接用 w350t root 登 continuum 的那把，只读挂进隧道容器
TUNNEL_KEY=/root/.ssh/id_rsa
TUNNEL_KNOWN_HOSTS=/root/.ssh/known_hosts
# w350t 上 ~/.ssh/config 里云服务器的别名，./ctl.sh init 用 ssh -G 取它的地址 / 用户 / 端口生成 ssh/hosts.conf
TUNNEL_SSH_ALIAS=continuum
# 云上 Continuum 的 PostgreSQL 经隧道发布到 w350t 的端口（家里电脑连 pg.tx.w350t.sz:这个端口）；w350t 自带 PG 占着 5432
PG_TX_PORT=15432

# 3.7 起才会协商 Docker API 版本；更老的版本写死 1.24，Docker 29 的守护进程直接拒绝（client version 1.24 is too old）
TRAEFIK_IMAGE=docker.io/traefik:v3.7

# HTTPS：用家里现成的自签 CA 给 *.w350t.sz 签通配证书（r9000p 已导入过这个根证书）
CA_CERT=/root/ca/ca.crt
CA_KEY=/root/ca/ca.key
# 证书有效期（天）与提前续签的天数；cert-cron 每周检查一次，剩余不足就重签，Traefik 自动热加载
CERT_DAYS=397
CERT_RENEW_BEFORE_DAYS=30
# 远端前缀，空格分隔：通配符只管一层，mihomo.tx.w350t.sz 需要单独的 *.tx.w350t.sz，每加一台远端在这里登记后 ./ctl.sh cert --force
CERT_REMOTE_PREFIXES=tx
