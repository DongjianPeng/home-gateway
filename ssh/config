# 隧道转发规则（唯一事实源）。远端地址 / 登录用户 / 端口在 hosts.conf 里，不进 git，
# ./ctl.sh init 从 w350t 的 ~/.ssh/config 自动生成。改了本文件：./ctl.sh restart tunnel-continuum
Include /root/.ssh/hosts.conf

Host *
    IdentityFile /root/.ssh/key
    UserKnownHostsFile /root/.ssh/known_hosts
    # 固化指纹：远端重装系统换了指纹时隧道拒连，而不是盲信新指纹
    StrictHostKeyChecking yes
    BatchMode yes
    # 每 15 秒探一次、连续 2 次没回应就认定断线：跨运营商到云上偶尔会静默断掉，30 秒内重连比 90 秒少挨一分钟
    ServerAliveInterval 15
    ServerAliveCountMax 2
    # 任何一条转发失败就退出，交给 docker 的 restart 重连
    ExitOnForwardFailure yes

# 云服务器 continuum。LocalForward 绑 0.0.0.0 绑的是容器自己的网络命名空间，
# 对局域网暴露与否由 docker-compose.yml 里隧道容器的 label 决定
Host continuum
    # mihomo-stack 管理页 -> https://mihomo.tx.<DOMAIN_SUFFIX>
    LocalForward 0.0.0.0:9091 127.0.0.1:9091
    # Continuum 的 PostgreSQL（云上只绑回环）-> 容器 5432，由 compose 发布到 w350t 的 PG_TX_PORT，家里电脑直连 pg.tx.<DOMAIN_SUFFIX>:<端口>
    LocalForward 0.0.0.0:5432 127.0.0.1:5432
